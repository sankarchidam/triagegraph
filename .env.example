# Copy this file to .env and fill in your own values -- .env is gitignored
# and never committed. config.py loads it automatically via pydantic-settings.

# Milestones 1-2 need no API key at all (normalize_alert, fetch_metrics,
# fetch_logs, fetch_deploys, assess_evidence are all rule-based; the
# postmortem store uses a local sentence-transformers model, not an API).

# Required starting Milestone 3 (generate_hypotheses / rank_hypotheses,
# the project's first real LLM calls). Pick a provider and set its key --
# graph/llm.py is the only place that reads llm_provider, so switching
# later is a one-line change here, not a code change.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional -- Milestone 5 (eval harness / tracing).
LANGSMITH_API_KEY=

DUMMY_MODE=true
ACTIVE_SCENARIO=kafka_consumer_lag_deploy
